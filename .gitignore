node_modules/
node_modules
.svelte-kit/
build/
src/lib/paraglide/
vite.config.ts.timestamp-*

# The android-tier probe bundle, built by tests/android-tier/run.mjs straight
# into the test APK's assets on every run.
android/app/src/androidTest/assets/

# Release artifacts and the CI logs kept from a failed browser run. Both have to
# stay untracked for another reason too: a release version needs an unedited
# tree (ADR-0022), so anything the pipeline writes into the workspace while it
# runs would otherwise turn the build it is packaging into a development build.
dist/
ci-logs/

# AI/agent-local files - session state, trackers and agent config stay out of the repo
.scratch/
.claude/
CLAUDE.md

# Docs stay out of the repo entirely.
docs/

# The same rule for the other assistants, listed ahead of anyone using one, since
# the repo is public and these files carry working notes rather than product
# decisions. Where a decision that matters is written down is covered below,
# under the briefs - docs/adr/ and CONTEXT.md are both kept out of the repo too.
.agents/
AGENTS.md
GEMINI.md
.gemini/
.cursor/
.cursorrules
.aider*
.continue/
.windsurfrules
.clinerules
.roo/
.roomodes
.codex/
.opencode/
.mcp.json

# The provisioning wizard and the test that exercises it. Operator tooling, not
# product: it walks one person through DNS, deployment access, a store account
# and a signing key, and what it says is specific to this machine - the ssh
# alias it reads the VPS address from, the deploy user, the state directory it
# keeps its own progress in. Nobody cloning a private diary app needs it, and it
# would be read as a setup step for the app itself.
#
# What outlives a run is which secret goes where and which ticket reads it, and
# that is docs/provisioning.md, which is tracked. The test goes with the script
# because it runs the script: kept here it would fail on any clone that has one
# and not the other.
scripts/provision.sh
tests/provisioning.test.ts

# Written on every build by the emitted-client-assets plugin in vite.config.ts
src/lib/pwa/*.generated.ts

# Generated from node_modules by scripts/prepare-tesseract-assets.mjs
static/tesseract/

# Throwaway prototypes, which live on their own branches and leave build output
# behind on this one - ticket 08's Android probe left 87M of Gradle output and a
# local.properties holding a machine's SDK path. The prototype/encryption-mechanism
# branch tracks its sources and is unaffected: ignoring a path does not untrack
# what is already committed under it.
prototype/

# Phase 0's throwaway static mockup, already committed under this path - same
# note as prototype/ above applies: ignoring it here stops new/changed files
# in it from showing up, not what git already tracks there.
mockup/

# The briefs the agent skills read, and the config that routes them. Same rule as
# docs/ above: they are working documents rather than product, they change far more
# often than the code they describe, and the repo is public - PRODUCT.md and
# SCREENS.md in particular carry unshipped screen-by-screen plans.
#
# Two things follow from this and are worth knowing before wondering where they went.
# Source comments across src/ cite CONTEXT.md by name as the domain authority, and on
# a clone those references now point at a file that is not there. And impeccable's
# context.mjs reads PRODUCT.md to resolve the platform, so on a clone it falls back to
# treating the app as a website - which is the exact failure phase 5 ticket 29 fixed.
# Both are accepted on the same trade docs/ already made: these live with whoever is
# working on the app, not in the public tree.
PRODUCT.md
SCREENS.md
CONTEXT.md
.impeccable/
