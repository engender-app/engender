node_modules/
node_modules
.svelte-kit/
build/
# A build copied aside to be looked at while work carries on. `npm run build`
# rewrites build/ and .svelte-kit/ under whatever is serving them, which kills
# a dev server mid-review; a snapshot in its own directory survives that.
build-live/
src/lib/paraglide/
vite.config.ts.timestamp-*

# The android-tier probe bundle, built by tests/android-tier/run.mjs straight
# into the test APK's assets on every run.
android/app/src/androidTest/assets/

# Release artifacts and the CI logs kept from a failed browser run. Both have to
# stay untracked for another reason too: a release version needs an unedited
# tree, so anything the pipeline writes into the workspace while it runs would
# otherwise turn the build it is packaging into a development build.
dist/
ci-logs/
/evidence*/
tests/*-20??-??-??.md

# AI/agent-local files - session state, trackers and agent config stay out of the repo
.scratch/
.claude/
CLAUDE.md
/codex-security.yaml

/brand/film/

# Optional documentation symlink. Match the link itself, without a trailing slash.
/docs/internal

# Local assistant configuration and working notes.
.agents/
AGENTS.md
GEMINI.md
.gemini/
.cursor/
.cursorrules
.aider*
.continue/
.windsurfrules
.clinerules
.roo/
.roomodes
.codex/
.opencode/
.mcp.json
copilot-instructions.md
.github/instructions/
.github/prompts/
.github/agents/

# Machine-specific provisioning tooling.
scripts/provision.sh
tests/provisioning.test.ts

# Written on every build by the emitted-client-assets plugin in vite.config.ts
src/lib/pwa/*.generated.ts

# Copied out of node_modules by scripts/prepare-vendor-assets.mjs
static/tesseract/
# Frozen pre-generation runtime copied by the same asset recipe
static/_app/immutable/chunks/C6xHUsg2.js
static/pdf-fonts/

# Throwaway prototypes, which live on their own branches and leave build output
# behind on this one - an Android probe run left 87M of Gradle output and a
# local.properties holding a machine's SDK path. The prototype/encryption-mechanism
# branch tracks its sources and is unaffected: ignoring a path does not untrack
# what is already committed under it.
prototype/

# An early throwaway static mockup, already committed under this path - same
# note as prototype/ above applies: ignoring it here stops new/changed files
# in it from showing up, not what git already tracks there.
mockup/

# Local documentation and design-tool configuration.
PRODUCT.md
SCREENS.md
CONTEXT.md
DIRECTION.md
.impeccable/
build-review/
