<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <!-- The other handlers the app opens for a result: leaving to one
             that is not a system app gets no lock grace (HandlerTrust), which
             needs the app to be able to see who would answer. -->
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.CREATE_DOCUMENT" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT_TREE" />
        </intent>
        <intent>
            <action android:name="android.provider.action.PICK_IMAGES" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <!-- Predictive back. Opting in is what lets the
         system draw the back gesture itself: as the finger drags from the
         edge, Android shows where the gesture is going and lets it be
         cancelled by dragging back. Without this flag the app is on the
         legacy path, where nothing appears until the gesture has already
         committed.

         It is also why the app plays no back animation of its own on
         Android (src/lib/navigation/screen-transition.ts returns 'none'
         there): a fixed animation on top of the system's preview is worse
         than no animation, because the system has already started showing
         the person the answer. The web keeps the reversed shared axis,
         where there is no such gesture to defer to.

         The back destination itself is unchanged and still decided by
         resolveAndroidBackAction; this changes how the gesture is drawn,
         not where it goes. -->

    <!-- Disable platform backup to keep app storage on the device.
         allowBackup covers Android 11 and older (minimum API 26) and
         cloud backup on Android 12+. dataExtractionRules also blocks
         device-to-device transfer on Android 12+. The journal key is
         bound to the Keystore, while WebView drafts and other state
         can contain private data. Export an archive for recovery. -->
    <application
        android:name=".JournalApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Opt out of per-app diagnostic uploads. Safe Browsing keeps
             WebView's enabled default. -->
        <meta-data android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />

        <!-- BackupWork uses ordinary delayed jobs without network constraints
             or foreground execution. Keep WorkManager's job and rescheduling
             owners; omit the two components those unused features add. -->
        <provider android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="merge">
            <meta-data android:name="androidx.work.WorkManagerInitializer" tools:node="remove" />
        </provider>
        <service android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:node="remove" />
        <receiver android:name="androidx.work.impl.background.systemalarm.ConstraintProxy$NetworkStateProxy"
            tools:node="remove" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.camera-files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/camera_file_paths" />
        </provider>

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="false">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>

        </activity>

        <!-- Keep LAUNCHER on the aliases. DisguiseAlias enumerates them from
             this manifest and enables exactly one. Launch01 is the default.
             LAUNCHER_IDENTITY names the palette, round variant or disguise.
             Use new neutral numbers for new aliases. Keep existing numbers
             stable because Android exposes component names.

             Disguise restarts the process. A flag-only change updates the
             launcher by the next cold start (ADR-0088). Route widget and
             notification actions through the enabled alias so Recents and
             TalkBack use its identity. Keep OPEN_ROUTE off MainActivity. -->
        <activity-alias
            android:name=".Launch01"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name">
            <meta-data android:name="dev.engender.app.LAUNCHER_IDENTITY" android:value="trans" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="dev.engender.app.action.OPEN_ROUTE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="engender" android:host="open" />
            </intent-filter>
        </activity-alias>

