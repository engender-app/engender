<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Predictive back (phase 5 ticket 18). Opting in is what lets the
         system draw the back gesture itself: as the finger drags from the
         edge, Android shows where the gesture is going and lets it be
         cancelled by dragging back. Without this flag the app is on the
         legacy path, where nothing appears until the gesture has already
         committed.

         It is also why the app plays no back animation of its own on
         Android (src/lib/navigation/screen-transition.ts returns 'none'
         there): a fixed animation on top of the system's preview is worse
         than no animation, because the system has already started showing
         the person the answer. The web keeps the reversed shared axis,
         where there is no such gesture to defer to.

         The back destination itself is unchanged and still decided by
         resolveAndroidBackAction; this changes how the gesture is drawn,
         not where it goes. -->
    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>

        </activity>

        <!-- Disguise's launcher identity (ticket 15). The LAUNCHER category
             lives on these aliases rather than on MainActivity itself, so
             which icon and label the system shows is a matter of which
             alias is enabled, not a string this app renders. Exactly one
             is enabled at a time - dev.barankiewicz.genderdiary.disguise.DisguiseAlias
             is what flips that - and Android kills and restarts the app
             process when it does, which is the "closes briefly to switch"
             disguise_app_sub_android warns about. -->
        <activity-alias
            android:name=".disguise.LauncherDefault"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".disguise.LauncherDisguised"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_disguised"
            android:roundIcon="@mipmap/ic_launcher_disguised"
            android:label="@string/app_name_disguised">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <receiver
            android:name=".reminders.ReminderAlarmReceiver"
            android:exported="false" />

        <!-- The quick-log widget (ticket 26). Exported, unlike the reminder
             alarm receiver above: APPWIDGET_UPDATE comes from the launcher,
             a different app, not a broadcast this app sends itself. -->
        <receiver
            android:name=".widgets.QuickLogWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_log_widget_info" />
        </receiver>

        <!-- The tally widget (ticket 33), same reasoning as the quick-log
             widget above: exported so the launcher can deliver
             APPWIDGET_UPDATE. -->
        <receiver
            android:name=".widgets.TallyWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tally_widget_info" />
        </receiver>

        <!-- The doubt-entry widget (ticket 34), same reasoning as the
             quick-log widget above: exported so the launcher can deliver
             APPWIDGET_UPDATE. -->
        <receiver
            android:name=".widgets.DoubtWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/doubt_widget_info" />
        </receiver>

        <receiver
            android:name=".reminders.ReminderRescheduleReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

    <!-- Permissions -->

    <!-- No android.permission.INTERNET, and that absence is the point (phase 5
         security ticket 03). The app makes no off-origin request anywhere -
         tests/browser-tier/verify-build.mjs asserts that online and offline -
         and the bundle it runs is served out of the APK by Capacitor's asset
         loader, which intercepts the request before any socket exists. So the
         permission bought nothing, and dropping it turns "no telemetry" into
         something a reader of the permission list can verify rather than take
         on trust.

         Answered with a build rather than an opinion. With this line removed,
         the connected suite was run on a Pixel 10a and then compared against
         the same suite with the line restored: the two runs fail the same
         tests. Nothing regressed on removal, and what passes covers the paths
         that could plausibly have wanted a socket - the WebView boots the real
         bundle, the native driver opens the journal and passes the whole
         contract suite over SQLCipher, the photo write channel writes and reads
         its files, the keystore holds the data key, the three widgets render,
         print reaches the spooler, and WebViewCspEnforcementTest fetches a
         bundled Tesseract asset off the app's own origin, which is the
         mechanism OCR loads its language data through.

         Four tests fail on that phone in both runs and none of them is about
         this: DisguiseAliasTest.mainActivityIsExcludedFromRecents asserts the
         opposite of what the manifest now says and of what
         tests/android-manifest-recents.test.ts asserts, two JournalKeystoreTest
         cases need a phone with no lock screen, and
         ArchiveCrossPlatformRoundTripTest cannot create its probe photo
         directory. The archive one is the only gap worth naming here, since an
         export is a path this question is about; it fails with the permission
         present too, on the same device, in the same isolated run.

         If something here ever does need a socket, put the line back with a
         comment naming what needed it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Voice notes (ticket 24). Recording itself needs no native code: it
         is plain getUserMedia/MediaRecorder, the same as the web build, and
         Capacitor's own BridgeWebChromeClient.onPermissionRequest already
         requests these two at the OS level and grants the WebView's
         AUDIO_CAPTURE resource once they are - see
         node_modules/@capacitor/android/capacitor/src/main/java/com/getcapacitor/BridgeWebChromeClient.java.
         Declared here only so that runtime request has something to grant. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Video notes (phase 5 ticket 22), by the same route: the same
         onPermissionRequest maps the WebView's VIDEO_CAPTURE resource to
         CAMERA (BridgeWebChromeClient.java lines 104-105), so getUserMedia
         asking for video is all it takes and there is no native bridge here
         either. RECORD_AUDIO above covers the sound half - a video note
         records both. No <uses-feature>: a device without a camera should
         still install and use every other part of the journal. -->
    <uses-permission android:name="android.permission.CAMERA" />
</manifest>
