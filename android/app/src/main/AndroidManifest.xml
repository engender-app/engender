    <!-- Permissions -->

    <!-- The app omits android.permission.INTERNET (ADR-0100). Capacitor
         intercepts bundled asset requests before they reach a socket, including
         the language data OCR loads. verify-build.mjs checks for off-origin
         app requests online and offline.

         An isolated Pixel 10a comparison found the same instrumentation
         results with the permission present and absent. The archive round-trip
         test could not create its probe photo directory in either run.
         A new socket dependency needs a decision superseding ADR-0100. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- WorkManager holds a wake lock during scheduled encrypted delivery.
         BackupWork never requests network constraints or foreground work. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <!-- Voice notes. Recording itself needs no native code: it
         is plain getUserMedia/MediaRecorder, the same as the web build, and
         Capacitor's own BridgeWebChromeClient.onPermissionRequest already
         requests these two at the OS level and grants the WebView's
         AUDIO_CAPTURE resource once they are - see
         node_modules/@capacitor/android/capacitor/src/main/java/com/getcapacitor/BridgeWebChromeClient.java.
         Declared here only so that runtime request has something to grant. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Video notes, by the same route: the same
         onPermissionRequest maps the WebView's VIDEO_CAPTURE resource to
         CAMERA (BridgeWebChromeClient.java lines 104-105), so getUserMedia
         asking for video is all it takes and there is no native bridge here
         either. RECORD_AUDIO above covers the sound half - a video note
         records both. Optional hardware declarations keep devices without
         a camera or microphone eligible to install the app. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
