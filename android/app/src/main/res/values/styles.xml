<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>

    <!-- The buttons of all three widgets (tickets 26, 33, 34): identical
         beyond the glyph each carries, so nothing about the layout itself
         reveals which is which - that's the button's own contentDescription
         at render time (DisguisableWidgetProvider), not this shared style.

         The view is the touch target, 48dp tall and with no margins, so it
         takes the whole slot it is given. The visible pill is 40dp, drawn
         inside the background's inset, and the layouts' padding shrank by
         the same amount, so the pills sit exactly where they did when the
         view itself was 40dp (after-release 19). -->
    <style name="WidgetMoodButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/widget_mood_button_bg</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#1A1A1A</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>