<?xml version="1.0" encoding="utf-8"?>
<!-- The check-in notification folded: five
     faces with the question under them, so a person sees what is asked
     without unfolding. Each face is one equal share of the width, a touch
     target at least 48dp wide and exactly 48dp tall. The faces come first
     because the system clips a folded notification to about 48dp once it has
     been unfolded and folded again, or redrawn for a theme change: seen on a
     Pixel, the first view of a new notification shows both, and after that
     the question is what gets clipped, never a face. From Android 12 the system's
     header line is not drawn on a folded notification, so the question is
     set here; before it the header shows it and this line is hidden
     (CheckInFaces.foldedShowsQuestion). Each face's contentDescription and
     PendingIntent are set in CheckInFaces.apply. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/check_in_face_1"
            style="@style/CheckInFaceFolded"
            android:src="@drawable/check_in_mood_1" />

        <ImageView
            android:id="@+id/check_in_face_2"
            style="@style/CheckInFaceFolded"
            android:src="@drawable/check_in_mood_2" />

        <ImageView
            android:id="@+id/check_in_face_3"
            style="@style/CheckInFaceFolded"
            android:src="@drawable/check_in_mood_3" />

        <ImageView
            android:id="@+id/check_in_face_4"
            style="@style/CheckInFaceFolded"
            android:src="@drawable/check_in_mood_4" />

        <ImageView
            android:id="@+id/check_in_face_5"
            style="@style/CheckInFaceFolded"
            android:src="@drawable/check_in_mood_5" />

    </LinearLayout>

    <TextView
        android:id="@+id/check_in_question"
        style="@style/CheckInQuestionFolded" />
</LinearLayout>
